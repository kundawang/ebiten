//kage:unit pixels

package main

var Weights [4]float

func Fragment(dstPos vec4, src0Pos vec2, color vec4) vec4 {
	w := Weights[0] + Weights[1] + Weights[2] + Weights[3]
	return vec4(w, w, w, 1)
}
